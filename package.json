{
  "name": "joel-bot-v2",
  "module": "index.ts",
  "type": "module",
  "version": "0.3.0",
  "description": "Joel Bot - originally a joke bot now became a functional one.",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "tsgo": "tsc --version",
    "build-windows": "bun build --compile --minify --target=bun-windows-x64 ./index.ts ./worker.ts --outfile joelbot-windows-x64",
    "build-linux-arm": "bun build --compile --target=bun-linux-arm64 ./index.ts ./worker.ts --outfile joelbot-linux-arm64",
    "build-linux": "bun build --compile --minify --target=bun-linux-x64 ./index.ts ./worker.ts --outfile joelbot-linux-x64",
    "build-linux2": "bun build --compile --target=bun-linux-x64-baseline ./index.ts ./worker.ts --outfile joelbot-linux-x64-baseline",
    "build-all": "bun build-windows && bun build-linux-arm && bun build-linux"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.28.0",
    "ffmpeg": "^1.1.3",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1",
    "sodium-native": "^5.2.0",
    "youtubei.js": "^18.3.0",
    "yt-dlp-wrap-plus": "^2.5.0"
  },
  "resolutions": {
    "tar": "^7.5.22"
  }
}
